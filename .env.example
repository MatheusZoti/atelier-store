# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon Postgres) ---
# Neon console → Connect → copy the connection string (pooled host, "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Better Auth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public URL of this app, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
